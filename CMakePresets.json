{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "description": "MSVC x64 project for Black Hole Sandbox",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/out/build/vs2026-x64",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/vs2026-x64"
      }
    },
    {
      "name": "ninja-msvc",
      "displayName": "Ninja + MSVC x64",
      "description": "Fast command-line build using the Visual Studio 2026 compiler",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/ninja-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/ninja-msvc"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug"
    },
    {
      "name": "build-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release"
    },
    {
      "name": "build-ninja-msvc",
      "configurePreset": "ninja-msvc"
    }
  ]
}
