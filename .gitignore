# Build output
out/
build/
_deps/
CMakeUserPresets.json

# Rendered images
*.png
*.jpg
render*.png
sheet/

# Editor / IDE
.vs/
.vscode/
*.user
*.suo

# Runtime state
imgui.ini

# Benchmark output.  A bench run is scratch and gets overwritten constantly;
# the reference images are the committed baseline it is measured against, so
# they are exempted from the blanket *.png rule above.
bench/current/
!bench/reference/*.png
